# ========== DATABASE ==========
# Local (docker compose) hoặc Supabase / Neon connection string
DATABASE_URL="postgresql://pod:pod@localhost:5432/pod_vn?schema=public"

# ========== API (apps/api) ==========
API_PORT=4000
# URL public của API (dùng để trả link file upload)
PUBLIC_API_URL="http://localhost:4000"
# Chuỗi ngẫu nhiên >= 32 ký tự. Tạo nhanh: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="doi-chuoi-nay-thanh-chuoi-ngau-nhien-dai-it-nhat-32-ky-tu"
# Các origin được gọi API (phân tách bằng dấu phẩy)
CORS_ORIGINS="http://localhost:3000,http://localhost:3001"

# Tài khoản admin tạo khi seed
ADMIN_EMAIL="admin@podviet.vn"
ADMIN_PASSWORD="Admin@123456"

# ========== WEB (apps/web) ==========
NEXT_PUBLIC_API_URL="http://localhost:4000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Tracking (để trống nếu chưa dùng)
NEXT_PUBLIC_GA4_ID=""
NEXT_PUBLIC_META_PIXEL_ID=""
# Khi dùng R2: đặt = R2_PUBLIC_URL để ảnh sản phẩm/thiết kế tối ưu qua next/image lấy thẳng từ CDN
NEXT_PUBLIC_UPLOADS_BASE=""

# ========== CMS (apps/cms) ==========
# CMS gọi API phía server
API_URL="http://127.0.0.1:4000"

# ========== TÍCH HỢP (tuỳ chọn) ==========
# Chuỗi bí mật để CMS báo web cập nhật ngay khi lưu (đặt giống nhau cho web + cms)
REVALIDATE_SECRET="doi-chuoi-nay-ngau-nhien"
# Thông báo đơn mới qua Telegram: tạo bot với @BotFather, lấy chat id qua @userinfobot
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# ========== LƯU ẢNH – Cloudflare R2 (khuyến nghị cho production) ==========
# Để trống = lưu vào ổ đĩa (apps/api/uploads) – chỉ dùng khi dev, mất file khi redeploy.
# R2 → Create bucket → Settings: bật Public access (r2.dev) hoặc gắn custom domain; R2 → Manage API tokens: quyền Object Read & Write.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
# Domain public của bucket, VD: https://cdn.oemgroup.vn hoặc https://pub-xxxx.r2.dev
R2_PUBLIC_URL=""
