# ============================================================
# YALA – biến môi trường PRODUCTION (yala.vn)
# Trên VPS: cp .env.production.example .env.production && nano .env.production
# KHÔNG commit file .env.production (đã có trong .gitignore)
# Các dòng <...> là giá trị CHỦ WEBSITE phải tự điền.
# ============================================================

# ---------- Tên miền ----------
NEXT_PUBLIC_SITE_URL="https://yala.vn"
# Trình duyệt chỉ gọi cùng domain (Nginx -> web -> api nội bộ); liệt kê để API chấp nhận CORS nếu cần
CORS_ORIGINS="https://yala.vn,https://admin.yala.vn"

# ---------- Database (PostgreSQL) ----------
# Cách 1 (khuyên dùng): Neon / Supabase – dán connection string, nhớ ?sslmode=require
# Cách 2: Postgres ngay trên VPS (chạy compose với --profile localdb):
#   DATABASE_URL="postgresql://yala:<POSTGRES_PASSWORD>@db:5432/yala?schema=public"
DATABASE_URL="<postgresql://USER:PASSWORD@HOST/DB?sslmode=require>"
# Chỉ cần khi dùng --profile localdb
POSTGRES_PASSWORD=""

# ---------- Bảo mật ----------
# Tạo: openssl rand -hex 48   (≥ 32 ký tự; đổi = mọi phiên đăng nhập bị đăng xuất)
JWT_SECRET="<chuoi-ngau-nhien-96-ky-tu>"
# CMS báo web làm mới nội dung ngay khi lưu (đặt chuỗi ngẫu nhiên bất kỳ)
REVALIDATE_SECRET="<chuoi-ngau-nhien-khac>"

# Tài khoản admin CMS tạo khi chạy seed LẦN ĐẦU (≥ 12 ký tự, không dùng mật khẩu mẫu)
ADMIN_EMAIL="<admin@yala.vn>"
ADMIN_PASSWORD="<mat-khau-manh-12-ky-tu-tro-len>"

# ---------- Lưu ảnh: Cloudflare R2 (khuyên dùng) ----------
# Để trống = lưu trong Docker volume "uploads" trên VPS (nhớ sao lưu – deploy/backup.sh đã gồm volume này)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
# Domain public của bucket, VD https://cdn.yala.vn
R2_PUBLIC_URL=""
# Đặt = R2_PUBLIC_URL để next/image lấy ảnh thẳng từ CDN (được "đóng băng" lúc build web)
NEXT_PUBLIC_UPLOADS_BASE=""

# ---------- Theo dõi & thông báo (tuỳ chọn) ----------
NEXT_PUBLIC_GA4_ID=""
NEXT_PUBLIC_META_PIXEL_ID=""
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# ---------- Deploy ----------
# Email nhận thông báo hết hạn SSL từ Let's Encrypt
CERTBOT_EMAIL="<email-cua-ban@yala.vn>"
# Số ngày giữ bản sao lưu
BACKUP_KEEP_DAYS=14
